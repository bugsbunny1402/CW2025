<?xml version="1.0" encoding="UTF-8"?>

<?import com.comp2042.GameOverPanel?>
<?import javafx.scene.Group?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import java.net.URL?>

<Pane fx:controller="com.comp2042.GuiController" xmlns:fx="http://javafx.com/fxml" prefWidth="450" prefHeight="550">

    <VBox layoutX="25.0" layoutY="10.0" spacing="5" alignment="TOP_CENTER">
        <Label styleClass="nextBrickLabel" text="HOLD"/>
        <GridPane fx:id="holdBrickPanel" hgap="1" vgap="1" styleClass="nextBrick" alignment="CENTER"/>
    </VBox>

    <BorderPane styleClass="gameBoard" fx:id="gameBoard" layoutX="125.0" layoutY="30.0">
        <center>
            <GridPane fx:id="gamePanel" hgap="1" vgap="1"/>
        </center>
    </BorderPane>

    <GridPane fx:id="brickPanel" vgap="1" hgap="1" layoutX="125.0" layoutY="30.0" mouseTransparent="true"/>

    <VBox layoutX="345.0" layoutY="10.0" spacing="20" alignment="TOP_CENTER">

        <VBox spacing="5" alignment="TOP_CENTER">
            <Label styleClass="nextBrickLabel" text="NEXT"/>
            <GridPane fx:id="nextBrickPanel" hgap="1" vgap="1" styleClass="nextBrick" alignment="CENTER"/>
        </VBox>

        <VBox spacing="5" alignment="CENTER">
            <Label text="BEST" styleClass="scoreTitle"/>
            <Label fx:id="highScoreLabel" text="0" styleClass="scoreValue"/>
        </VBox>

        <VBox spacing="5" alignment="CENTER">
            <Label text="SCORE" styleClass="scoreTitle"/>
            <Label fx:id="scoreLabel" text="0" styleClass="scoreValue"/>
        </VBox>

        <VBox spacing="5" alignment="CENTER">
            <Label text="LEVEL" styleClass="scoreTitle"/>
            <Label fx:id="levelLabel" text="1" styleClass="scoreValue"/>
        </VBox>

    </VBox>

    <StackPane fx:id="pauseMenu" visible="false" layoutX="125.0" layoutY="30.0" prefWidth="200" prefHeight="400" styleClass="pauseBackground">
        <VBox alignment="CENTER" spacing="20">
            <Label text="PAUSED" styleClass="pauseTitle"/>
            <Label text="Press 'P' to Resume" styleClass="pauseInstruction"/>
        </VBox>
    </StackPane>

    <Group fx:id="groupNotification" layoutX="125.0" layoutY="200.0">
        <VBox alignment="CENTER">
            <GameOverPanel fx:id="gameOverPanel"/>
        </VBox>
    </Group>

    <stylesheets>
        <URL value="@window_style.css"/>
    </stylesheets>
</Pane>